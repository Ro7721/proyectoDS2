# =============================================
# Variables de Entorno para Docker
# =============================================
# Copia este archivo como .env y ajusta los valores
# NUNCA subas el archivo .env a git

# Base de datos MySQL
MYSQL_ROOT_PASSWORD=CambiaEstoPorUnaContraseñaSegura123!
MYSQL_USER=appuser
MYSQL_PASSWORD=CambiaEstoPorOtraContraseñaSegura456!

# JWT - Genera un nuevo secreto seguro para producción
# Puedes generarlo con: openssl rand -base64 64
JWT_SECRET=dGhpc0lzQVN1cGVyU2VjcmV0S2V5Rm9ySldUQXV0aGVudGljYXRpb25NaW5pbXVtMjU2Qml0cw==
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# URL base de la aplicación (cambia por tu dominio en producción)
APP_BASE_URL=http://localhost:8080
